# Public base URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — leave empty to run checkout in explicit DEMO mode (no charges).
# Use a test key (sk_test_...) to try real Stripe Checkout in test mode.
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook (from `stripe listen` or the Dashboard)
STRIPE_WEBHOOK_SECRET=
